{"messages": [{"id": 36, "frm": "MJ", "to": "all", "text": "", "kind": "clear", "speed": 0, "ts": 1784329455.2211108}, {"id": 37, "frm": "MJ", "to": "all", "text": "", "kind": "boot", "speed": 24, "ts": 1784329462.2605443}, {"id": 38, "frm": "MJ", "to": "Wilson", "text": "NOUVELLE DIRECTIVE — ORDRE SPECIAL 966\n\nVOTRE PROCHAINE MISSION A ETE MODIFIEE. \nUN VAISSEAU SCIENTIFIQUE DE LA COMPAGNIE PERDU IL Y A 75 ANS A REFAIT SURFACE, L'USCSS CRONUS.\n\nORDRES DE MISSION MIS A JOURS:\n1. FAIRE UN ETAT DES LIEUX DES EVENEMENTS AYANT PROVOQUES LA PERTE DU VAISSEAU CRONUS\n\nLE RESTE DE L'EQUIPAGE N'EST PAS AU COURANT ET NE DOIT PAS VOUS SOUPCONNER!", "kind": "text", "speed": 24, "ts": 1784329479.9191875}, {"id": 39, "frm": "MJ", "to": "Miller", "text": "BONJOUR CAPITAINE.\n\nPRIORITEES DE LA MISSION:\n1. ACHEMINER LA CARGAISON D'HELIUM - 3 JUSQU'A LA COLONIE DE SUTTER\n2. GARANTIR LA SECURITE DU VAISSEAU\n3. GARANTIR LA SECURITE DE L'EQUIPAGE\n\nLA COMPAGNIE VOUS REMERCIE DE VOTRE DEVOUEMENT", "kind": "text", "speed": 24, "ts": 1784329546.4338498}, {"id": 41, "frm": "MJ", "to": "Miller", "text": "40", "kind": "delete", "speed": 0, "ts": 1784329792.4872808}, {"id": 42, "frm": "MJ", "to": "Test", "text": "Bonjour Maxime", "kind": "text", "speed": 24, "ts": 1784444903.54721}, {"id": 43, "frm": "Test", "to": "MJ", "text": "Prout", "kind": "text", "speed": 0, "ts": 1784450142.5680943}, {"id": 44, "frm": "Test", "to": "MJ", "text": "Test", "kind": "text", "speed": 0, "ts": 1784450168.3712387}, {"id": 45, "frm": "MJ", "to": "Test", "text": "Saucisse", "kind": "alert", "speed": 24, "ts": 1784450180.2501338}, {"id": 46, "frm": "Test", "to": "MJ", "text": "Coucou", "kind": "text", "speed": 0, "ts": 1784450185.880973}, {"id": 47, "frm": "MJ", "to": "Test", "text": "Yo", "kind": "text", "speed": 24, "ts": 1784450199.916252}, {"id": 48, "frm": "Test", "to": "MJ", "text": "sudo apt install fix-ship", "kind": "text", "speed": 0, "ts": 1784450213.1633172}, {"id": 49, "frm": "Test", "to": "MJ", "text": "fix-ship --all", "kind": "text", "speed": 0, "ts": 1784450225.7135465}, {"id": 50, "frm": "MJ", "to": "Test", "text": "ACCÈS REFUSÉ. AUTORISATION INSUFFISANTE.", "kind": "alert", "speed": 24, "ts": 1784450227.6590128}, {"id": 51, "frm": "Test", "to": "MJ", "text": "Eh pas cool", "kind": "text", "speed": 0, "ts": 1784450240.1525612}, {"id": 52, "frm": "Test", "to": "MJ", "text": "help", "kind": "text", "speed": 0, "ts": 1784450251.5200856}, {"id": 53, "frm": "MJ", "to": "Test", "text": "Bon c'est cool ça marche a peu près bien", "kind": "text", "speed": 24, "ts": 1784450288.3157814}, {"id": 54, "frm": "Test", "to": "MJ", "text": "Yes, je te confirme que j'ai l'interface qui change de couleur aussi", "kind": "text", "speed": 0, "ts": 1784450314.1120372}, {"id": 55, "frm": "Test", "to": "MJ", "text": "De vert à rouge", "kind": "text", "speed": 0, "ts": 1784450318.9956472}, {"id": 56, "frm": "Test", "to": "MJ", "text": "J'aime beaucoup, c'est très stylé", "kind": "text", "speed": 0, "ts": 1784450338.044295}], "next_id": 57, "codes": {"davis": "FuckLesProcess", "wilson": "ILoveWeyland", "miller": "NeedBetterShip", "rye": "ThisJobSucks", "cham": "Cham1234", "test": "1234"}, "names": {"davis": "Davis", "wilson": "Wilson", "miller": "Miller", "rye": "Rye", "cham": "Cham", "test": "Test"}, "timer": null}